# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: To use native ChatGPT (gpt-4o-mini) as the live Copilot engine
OPENAI_API_KEY=""

# Optional: To use native Claude (claude-3-5-sonnet) as the live Copilot engine
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
